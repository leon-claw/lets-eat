NODE_ENV=production
API_PORT=3001
# 从源码构建时使用 local；部署预构建 Release 镜像时改为对应镜像标签。
API_IMAGE_TAG=local

POSTGRES_DB=lets_eat
POSTGRES_USER=lets_eat
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgresql://lets_eat:replace-with-a-random-hex-password@postgres:5432/lets_eat

JWT_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGINS=https://example.com
TRUST_PROXY=loopback
CATALOG_VERSION=v2

# Host port mapped to the web/nginx container. Cloudflare Tunnel can target this port.
WEB_PORT=8080
