{
  "name": "lets-eat",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "pnpm --filter @lets-eat/web dev",
    "dev:web": "pnpm --filter @lets-eat/web dev",
    "dev:api": "pnpm --filter @lets-eat/contracts build && pnpm --filter @lets-eat/api dev",
    "dev:stack": "bash scripts/dev-stack.sh",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "test": "pnpm test:latency && pnpm test:workspaces",
    "test:latency": "node --test scripts/network-latency.test.mjs",
    "test:workspaces": "pnpm -r --workspace-concurrency=1 test",
    "latency:on": "node scripts/network-latency.mjs on",
    "latency:off": "node scripts/network-latency.mjs off",
    "latency:status": "node scripts/network-latency.mjs status",
    "nearby:classifier:generate": "node scripts/nearby-classifier/generate-dataset.mjs",
    "nearby:classifier:validate": "node scripts/nearby-classifier/validate-dataset.mjs",
    "nearby:classifier:train": "node scripts/nearby-classifier/train.mjs",
    "nearby:classifier:evaluate": "node scripts/nearby-classifier/evaluate.mjs",
    "db:up": "docker compose up -d postgres",
    "db:test:up": "docker compose --profile test up -d postgres-test"
  },
  "devDependencies": {
    "typescript": "~5.8.2"
  }
}
