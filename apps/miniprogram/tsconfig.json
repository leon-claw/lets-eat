{
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["miniprogram-api-typings"],
    "baseUrl": "."
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests", "dist"]
}
