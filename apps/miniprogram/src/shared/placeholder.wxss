.placeholder-page {
  min-height: 100vh;
  padding: 20px 16px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-card {
  width: 100%;
  max-width: 430px;
  padding: 32px 24px;
  box-sizing: border-box;
  border-radius: 28px;
  background: #ffffff;
  box-shadow: 0 16px 36px rgba(15, 23, 42, 0.12);
  text-align: center;
}

.placeholder-title {
  display: block;
  font-size: 26px;
  line-height: 1.3;
  font-weight: 900;
}

.placeholder-message {
  display: block;
  margin-top: 12px;
  color: #64748b;
  font-size: 14px;
  line-height: 1.5;
}

.placeholder-button {
  width: auto !important;
  min-width: 0 !important;
  margin: 24px auto 0 !important;
  padding: 0 20px !important;
  border-radius: 16px;
  background: #ffd100;
  color: #0f172a;
  font-weight: 900;
}
