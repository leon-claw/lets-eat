.room-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20px 16px 28px;
  color: #0f172a;
}

.room-content {
  width: 100%;
  max-width: 430px;
  margin: 0 auto;
  animation: page-enter 240ms cubic-bezier(0.23, 1, 0.32, 1) both;
}

.page-header {
  min-height: 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-title {
  flex: 1;
  color: #0f172a;
  font-size: 18px;
  line-height: 40px;
  font-weight: 900;
  text-align: center;
}

.header-spacer {
  width: 70px;
  flex: 0 0 70px;
}

.back-button {
  width: 70px !important;
  min-width: 70px !important;
  height: 40px !important;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 12px;
  background: transparent;
  color: #475569;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 3px;
  font-size: 13px;
  line-height: 40px;
  font-weight: 800;
}

.back-button--pressed {
  background: #e2e8f0;
  transform: scale(0.98);
}

.back-icon {
  margin-top: -2px;
  font-size: 28px;
  line-height: 1;
  font-weight: 400;
}

.room-code-card {
  margin-top: 24px;
  padding: 24px 20px 18px;
  border-radius: 28px;
  background: #0f172a;
  color: #ffffff;
  text-align: center;
  box-shadow: 0 18px 36px rgba(15, 23, 42, 0.2);
}

.room-code-label {
  display: block;
  color: #cbd5e1;
  font-size: 13px;
  line-height: 1.3;
  font-weight: 800;
}

.room-code {
  display: block;
  margin-top: 8px;
  color: #fef3c7;
  font-size: 36px;
  line-height: 1.1;
  font-weight: 950;
  letter-spacing: 0.12em;
}

.copy-button {
  width: 116px !important;
  min-width: 116px !important;
  height: 32px !important;
  display: block;
  margin: 14px auto 0 !important;
  padding: 0 !important;
  border: 1px solid rgba(253, 230, 138, 0.5);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  color: #fde68a;
  font-size: 12px;
  line-height: 30px;
  font-weight: 900;
}

.copy-button::after {
  border: 0;
}

.dataset-card,
.guest-status-card,
.results-card,
.members-card {
  margin-top: 16px;
  padding: 20px;
  border-radius: 24px;
  background: #ffffff;
  box-shadow: 0 9px 22px rgba(15, 23, 42, 0.08);
}

.section-heading,
.members-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  color: #0f172a;
  font-size: 16px;
  line-height: 1.3;
  font-weight: 950;
}

.section-hint,
.member-count {
  color: #94a3b8;
  font-size: 11px;
  line-height: 1.3;
  font-weight: 800;
}

.dataset-switcher {
  display: flex;
  margin-top: 14px;
}

.dataset-button {
  flex: 1;
  width: auto !important;
  min-width: 0 !important;
  height: 44px !important;
  margin: 0 6px 0 0 !important;
  padding: 0 4px !important;
  border: 0;
  border-radius: 14px;
  background: #f1f5f9;
  color: #475569;
  font-size: 12px;
  line-height: 44px;
  font-weight: 900;
}

.dataset-button:last-child {
  margin-right: 0 !important;
}

.dataset-button::after {
  border: 0;
}

.dataset-button--selected {
  background: #ffd100;
  color: #0f172a;
  box-shadow: 0 6px 12px rgba(245, 158, 11, 0.18);
}

.dataset-button--disabled {
  background: #f8fafc;
  color: #cbd5e1;
}

.dataset-current {
  display: block;
  margin-top: 12px;
  color: #64748b;
  font-size: 12px;
  line-height: 1.4;
  font-weight: 800;
}

.dataset-hint {
  display: block;
  margin-top: 6px;
  color: #94a3b8;
  font-size: 11px;
  line-height: 1.4;
}

.guest-status-card,
.results-card {
  text-align: center;
}

.guest-kicker,
.results-label {
  display: block;
  color: #94a3b8;
  font-size: 12px;
  line-height: 1.3;
  font-weight: 900;
}

.guest-dataset {
  display: block;
  margin-top: 7px;
  color: #0f172a;
  font-size: 24px;
  line-height: 1.2;
  font-weight: 950;
}

.waiting-title {
  display: block;
  margin-top: 18px;
  color: #0f172a;
  font-size: 20px;
  line-height: 1.3;
  font-weight: 950;
}

.waiting-message {
  display: block;
  margin-top: 8px;
  color: #64748b;
  font-size: 13px;
  line-height: 1.5;
}

.action-button {
  width: 100% !important;
  min-width: 0 !important;
  height: 52px !important;
  margin: 16px 0 0 !important;
  padding: 0 16px !important;
  border: 0;
  border-radius: 18px;
  font-size: 16px;
  line-height: 52px;
  font-weight: 950;
}

.action-button::after,
.state-button::after,
.leave-button::after,
.modal-submit::after,
.confirm-button::after {
  border: 0;
}

.action-button--primary {
  background: #ffd100;
  color: #0f172a;
  box-shadow: 0 10px 20px rgba(245, 158, 11, 0.2);
}

.action-button--secondary {
  background: #ffffff;
  color: #0f172a;
  box-shadow: 0 9px 18px rgba(15, 23, 42, 0.08);
}

.member-list {
  margin-top: 14px;
}

.member-item {
  min-height: 48px;
  margin-top: 8px;
  padding: 8px 12px;
  box-sizing: border-box;
  border-radius: 16px;
  background: #f8fafc;
  display: flex;
  align-items: center;
}

.member-item:first-child {
  margin-top: 0;
}

.member-avatar {
  width: 32px;
  height: 32px;
  margin-right: 10px;
  border-radius: 50%;
  background: #fef3c7;
  color: #d97706;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
}

.member-name {
  flex: 1;
  overflow: hidden;
  color: #0f172a;
  font-size: 14px;
  line-height: 1.3;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-role {
  margin-left: 8px;
  color: #94a3b8;
  font-size: 11px;
  line-height: 1.3;
  font-weight: 900;
}

.member-role--host {
  color: #d97706;
}

.leave-button {
  width: 100% !important;
  min-width: 0 !important;
  height: 44px !important;
  margin: 14px 0 0 !important;
  padding: 0 !important;
  border: 0;
  border-radius: 16px;
  background: #f1f5f9;
  color: #64748b;
  font-size: 13px;
  line-height: 44px;
  font-weight: 900;
}

.state-panel {
  width: 100%;
  max-width: 430px;
  min-height: calc(100vh - 48px);
  margin: 0 auto;
  box-sizing: border-box;
  padding: 48px 24px;
  border-radius: 28px;
  background: #ffffff;
  box-shadow: 0 20px 44px rgba(15, 23, 42, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-emoji {
  display: block;
  margin-bottom: 20px;
  font-size: 52px;
  line-height: 1;
}

.state-title {
  display: block;
  color: #0f172a;
  font-size: 23px;
  line-height: 1.3;
  font-weight: 950;
}

.state-message {
  display: block;
  max-width: 290px;
  margin-top: 10px;
  color: #64748b;
  font-size: 14px;
  line-height: 1.6;
}

.state-button {
  width: 100% !important;
  min-width: 0 !important;
  height: 48px !important;
  margin: 22px 0 0 !important;
  padding: 0 16px !important;
  border: 0;
  border-radius: 16px;
  font-size: 15px;
  line-height: 48px;
  font-weight: 900;
}

.state-button--primary,
.modal-submit {
  background: #0f172a;
  color: #ffffff;
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.18);
}

.state-button--secondary {
  margin-top: 10px !important;
  background: #f1f5f9;
  color: #475569;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  padding: 24px;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-card {
  width: 100%;
  max-width: 360px;
  box-sizing: border-box;
  padding: 22px;
  border-radius: 24px;
  background: #ffffff;
  box-shadow: 0 20px 44px rgba(15, 23, 42, 0.2);
  animation: modal-enter 180ms cubic-bezier(0.23, 1, 0.32, 1) both;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-title {
  color: #0f172a;
  font-size: 20px;
  line-height: 1.3;
  font-weight: 950;
}

.modal-close {
  width: 32px !important;
  min-width: 32px !important;
  height: 32px !important;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 50%;
  background: #f1f5f9;
  color: #64748b;
  font-size: 24px;
  line-height: 30px;
  font-weight: 400;
}

.modal-close::after {
  border: 0;
}

.modal-message {
  display: block;
  margin-top: 8px;
  color: #64748b;
  font-size: 13px;
  line-height: 1.5;
}

.room-input {
  width: 100%;
  height: 52px;
  box-sizing: border-box;
  margin-top: 18px;
  padding: 0 16px;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  background: #f8fafc;
  color: #0f172a;
  font-size: 20px;
  line-height: 52px;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-align: center;
}

.input-error {
  display: block;
  margin-top: 8px;
  color: #e11d48;
  font-size: 12px;
  line-height: 1.4;
  font-weight: 800;
  text-align: center;
}

.modal-submit {
  width: 100% !important;
  min-width: 0 !important;
  height: 48px !important;
  margin: 18px 0 0 !important;
  padding: 0 16px !important;
  border: 0;
  border-radius: 16px;
  font-size: 15px;
  line-height: 48px;
  font-weight: 900;
}

.confirm-actions {
  display: flex;
  margin-top: 22px;
}

.confirm-button {
  flex: 1;
  width: auto !important;
  min-width: 0 !important;
  height: 46px !important;
  margin: 0 8px 0 0 !important;
  padding: 0 8px !important;
  border: 0;
  border-radius: 14px;
  font-size: 14px;
  line-height: 46px;
  font-weight: 900;
}

.confirm-button:last-child {
  margin-right: 0 !important;
}

.confirm-button--cancel {
  background: #f1f5f9;
  color: #475569;
}

.confirm-button--danger {
  background: #0f172a;
  color: #ffffff;
}

.toast {
  position: fixed;
  top: 38%;
  left: 50%;
  max-width: calc(100vw - 48px);
  padding: 12px 18px;
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.9);
  color: #ffffff;
  font-size: 14px;
  line-height: 1.35;
  font-weight: 700;
  text-align: center;
  transform: translate(-50%, -50%);
  z-index: 40;
}

.pressable {
  transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1), background-color 140ms ease, opacity 140ms ease;
}

.entry-fade-up {
  animation: entry-fade-up 220ms cubic-bezier(0.23, 1, 0.32, 1) both;
}

.entry-delay-40 {
  animation-delay: 40ms;
}

.entry-delay-80 {
  animation-delay: 80ms;
}

.entry-delay-120 {
  animation-delay: 120ms;
}

@keyframes page-enter {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes entry-fade-up {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes modal-enter {
  from {
    opacity: 0;
    transform: translateY(8px) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
