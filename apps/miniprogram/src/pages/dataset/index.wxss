.page-shell {
  min-height: 100vh;
  padding: 20px 16px;
  box-sizing: border-box;
  color: #0f172a;
}

.page-main {
  width: 100%;
  max-width: 430px;
  min-height: calc(100vh - 40px);
  margin: 0 auto;
  animation: page-shell-enter 220ms cubic-bezier(0.23, 1, 0.32, 1) both;
}

.dataset-content {
  padding-top: 28px;
}

.intro {
  display: block;
  margin-bottom: 24px;
  color: #64748b;
  font-size: 14px;
  line-height: 1.5;
  text-align: center;
}

.dataset-option {
  width: 100% !important;
  min-width: 0 !important;
  min-height: 104px !important;
  margin: 0 0 16px !important;
  padding: 20px !important;
  box-sizing: border-box;
  border: 1px solid #f1f5f9;
  border-radius: 24px;
  background: #ffffff;
  color: #0f172a;
  box-shadow: 0 8px 18px rgba(15, 23, 42, 0.08);
  text-align: left;
  transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1), background-color 180ms ease, box-shadow 180ms ease;
}

.dataset-option:active {
  transform: scale(0.985);
}

.dataset-option--large-hover {
  background: #fffdf0;
  transform: translateY(-2px);
}

.dataset-option--small-hover {
  background: #fff8fa;
  transform: translateY(-2px);
}

.dataset-option--nearby {
  border-style: dashed;
  border-color: #cbd5e1;
  background: #f1f5f9;
  opacity: 0.72;
}

.dataset-option--nearby-hover {
  background: #e2e8f0;
}

.dataset-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.dataset-icon {
  width: 28px;
  min-width: 28px;
  font-size: 24px;
  line-height: 1;
  text-align: center;
}

.dataset-icon--large {
  color: #f59e0b;
}

.dataset-icon--small {
  color: #f43f5e;
}

.dataset-icon--nearby {
  color: #94a3b8;
  font-size: 28px;
}

.dataset-title {
  flex: 1;
  font-size: 18px;
  line-height: 1.35;
  font-weight: 900;
}

.dataset-count {
  padding: 6px 10px;
  border-radius: 999px;
  background: #fef3c7;
  color: #92400e;
  font-size: 12px;
  line-height: 1.3;
  font-weight: 900;
  white-space: nowrap;
}

.dataset-option--small .dataset-count {
  background: #ffe4e6;
  color: #be123c;
}

.dataset-description {
  display: block;
  margin-top: 12px;
  color: #64748b;
  font-size: 14px;
  line-height: 1.4;
}

.toast {
  position: fixed;
  top: 38%;
  left: 50%;
  max-width: calc(100vw - 48px);
  padding: 12px 18px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.9);
  color: #ffffff;
  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.2);
  font-size: 14px;
  line-height: 1.35;
  font-weight: 700;
  text-align: center;
  transform: translate(-50%, -50%);
  z-index: 20;
}

.pressable {
  transition-property: transform, background-color, border-color, box-shadow;
  transition-duration: 140ms;
  transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
}

.entry-fade-up {
  animation: entry-fade-up 220ms cubic-bezier(0.23, 1, 0.32, 1) both;
}

.entry-delay-40 {
  animation-delay: 40ms;
}

.entry-delay-80 {
  animation-delay: 80ms;
}

.entry-delay-120 {
  animation-delay: 120ms;
}

@keyframes page-shell-enter {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes entry-fade-up {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
