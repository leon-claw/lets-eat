.nearby-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20px 16px 28px;
  background: #f5f5f7;
  color: #0f172a;
}

.nearby-shell {
  width: 100%;
  max-width: 430px;
  margin: 0 auto;
}

.nearby-header {
  display: flex;
  min-height: 32px;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
}

.back-button {
  display: flex;
  width: 72px !important;
  height: 32px !important;
  align-items: center;
  justify-content: flex-start;
  gap: 4px;
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
  border-radius: 0;
  background: transparent;
  color: #475569;
  font-size: 18px;
  line-height: 32px;
  font-weight: 600;
  text-align: left;
}

.back-arrow {
  display: block;
  margin-top: -2px;
  font-size: 36px;
  line-height: 28px;
  font-weight: 300;
}

.page-title {
  color: #020617;
  font-size: 18px;
  line-height: 1.3;
  font-weight: 950;
}

.header-spacer {
  width: 72px;
  height: 1px;
}

.nearby-content {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.nearby-hero {
  padding: 20px;
  box-sizing: border-box;
  border-radius: 32px;
  background: #0f172a;
  color: #ffffff;
  box-shadow: 0 18px 36px rgba(15, 23, 42, 0.18);
}

.nearby-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.nearby-hero-copy {
  min-width: 0;
}

.nearby-kicker {
  display: block;
  color: #7dd3fc;
  font-size: 10px;
  line-height: 1.3;
  font-weight: 950;
  letter-spacing: 0.2em;
}

.nearby-title {
  display: block;
  margin-top: 8px;
  color: #ffffff;
  font-size: 24px;
  line-height: 1.2;
  font-weight: 950;
}

.nearby-subtitle {
  display: block;
  margin-top: 8px;
  color: #cbd5e1;
  font-size: 12px;
  line-height: 1.4;
}

.nearby-hero-icon {
  display: flex;
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: rgba(56, 189, 248, 0.2);
  color: #bae6fd;
  font-size: 30px;
  line-height: 1;
}

.nearby-hero-status {
  display: flex;
  height: 36px;
  box-sizing: border-box;
  align-items: center;
  gap: 8px;
  margin-top: 20px;
  padding: 0 12px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.1);
  color: #e2e8f0;
  font-size: 12px;
  line-height: 36px;
}

.status-dot {
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  border-radius: 50%;
  background: #fbbf24;
}

.status-dot--ready {
  background: #4ade80;
}

.status-dot--busy {
  background: #fbbf24;
}

.filter-card {
  padding: 16px;
  border-radius: 24px;
  background: #ffffff;
  box-shadow: 0 9px 22px rgba(15, 23, 42, 0.08);
}

.filter-row {
  display: flex;
  gap: 12px;
}

.filter-item {
  flex: 1;
  min-width: 0;
}

.filter-label {
  display: block;
  color: #94a3b8;
  font-size: 11px;
  line-height: 1.3;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.picker-value {
  height: 44px;
  box-sizing: border-box;
  margin-top: 8px;
  padding: 0 12px;
  overflow: hidden;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  background: #f8fafc;
  color: #0f172a;
  font-size: 12px;
  line-height: 44px;
  font-weight: 900;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.change-location-button,
.plain-button,
.notice-button {
  display: flex;
  width: 100% !important;
  min-width: 0 !important;
  height: 44px !important;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin: 0 !important;
  padding: 0 12px !important;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  background: #f8fafc;
  color: #475569;
  font-size: 12px;
  line-height: 42px;
  font-weight: 900;
}

.change-location-button {
  margin-top: 16px !important;
}

.action-icon {
  color: #64748b;
  font-size: 17px;
  line-height: 1;
}

.search-actions {
  display: flex;
  gap: 12px;
}

.search-actions .plain-button {
  flex: 1;
}

.plain-button[disabled] {
  opacity: 0.5;
}

.nearby-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nearby-action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 !important;
  line-height: 1 !important;
}

.start-button,
.exit-button {
  width: 100% !important;
  box-sizing: border-box;
  margin: 0 !important;
  border: 0;
  font-weight: 950;
}

.start-button {
  height: 52px !important;
  border-radius: 16px;
  background: #facc15;
  color: #020617;
  font-size: 16px;
  line-height: 52px;
}

.start-button--disabled {
  opacity: 0.45;
}

.exit-button {
  height: 44px !important;
  border-radius: 14px;
  background: #020617;
  color: #ffffff;
  font-size: 12px;
  line-height: 44px;
}

.state-panel {
  min-height: 190px;
  box-sizing: border-box;
  padding: 28px 22px;
  border-radius: 24px;
  background: #ffffff;
  box-shadow: 0 9px 22px rgba(15, 23, 42, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-emoji {
  font-size: 38px;
  line-height: 1;
}

.state-title {
  display: block;
  margin-top: 13px;
  color: #0f172a;
  font-size: 17px;
  line-height: 1.3;
  font-weight: 950;
}

.state-message,
.notice-subtitle {
  display: block;
  margin-top: 7px;
  color: #64748b;
  font-size: 12px;
  line-height: 1.5;
}

.notice-panel {
  padding: 14px 16px;
  border-radius: 18px;
  font-size: 12px;
  line-height: 1.5;
  font-weight: 800;
  text-align: center;
}

.notice-panel--warning {
  background: #fffbeb;
  color: #92400e;
}

.notice-panel--error {
  background: #fff1f2;
  color: #be123c;
}

.notice-button {
  width: 144px !important;
  border-color: #fecdd3;
  background: #ffffff;
  color: #be123c;
}

.results-heading {
  padding: 0 2px;
}

.results-title {
  display: block;
  color: #0f172a;
  font-size: 15px;
  line-height: 1.3;
  font-weight: 950;
}

.results-subtitle {
  display: block;
  margin-top: 5px;
  color: #94a3b8;
  font-size: 10px;
  line-height: 1.4;
}

.nearby-page button::after {
  border: 0;
}

.pressable {
  transition: transform 120ms ease, opacity 120ms ease;
}

.pressable:active {
  transform: scale(0.98);
  opacity: 0.88;
}

.entry-fade-up {
  animation: nearby-fade-up 360ms ease both;
}

.entry-delay-40 {
  animation-delay: 40ms;
}

@keyframes nearby-fade-up {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
