.result-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20px 16px 28px;
  color: #0f172a;
}

.result-content {
  width: 100%;
  max-width: 430px;
  margin: 0 auto;
}

.page-header {
  min-height: 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-title {
  flex: 1;
  color: #0f172a;
  font-size: 18px;
  line-height: 40px;
  font-weight: 900;
  text-align: center;
}

.header-spacer {
  width: 70px;
  flex: 0 0 70px;
}

.back-button {
  width: 70px !important;
  min-width: 70px !important;
  height: 40px !important;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 12px;
  background: transparent;
  color: #475569;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 3px;
  font-size: 13px;
  line-height: 40px;
  font-weight: 800;
}

.back-button::after {
  border: 0;
}

.back-button--pressed {
  background: #e2e8f0;
  transform: scale(0.98);
}

.back-icon {
  margin-top: -2px;
  font-size: 28px;
  line-height: 1;
  font-weight: 400;
}

.result-hero {
  margin-top: 22px;
  padding: 26px 18px 24px;
  border-radius: 28px;
  background: #0f172a;
  color: #ffffff;
  text-align: center;
  box-shadow: 0 18px 36px rgba(15, 23, 42, 0.2);
}

.result-emoji {
  display: block;
  font-size: 44px;
  line-height: 1;
}

.result-title {
  display: block;
  margin-top: 14px;
  color: #fef3c7;
  font-size: 24px;
  line-height: 1.3;
  font-weight: 950;
}

.result-subtitle {
  display: block;
  margin-top: 8px;
  color: #cbd5e1;
  font-size: 13px;
  line-height: 1.5;
}

.section-card {
  margin-top: 16px;
  padding: 20px;
  border-radius: 24px;
  background: #ffffff;
  box-shadow: 0 9px 22px rgba(15, 23, 42, 0.08);
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  color: #0f172a;
  font-size: 17px;
  line-height: 1.3;
  font-weight: 950;
}

.section-count {
  color: #94a3b8;
  font-size: 11px;
  line-height: 1.3;
  font-weight: 900;
}

.common-list,
.player-list {
  margin-top: 14px;
}

.common-item {
  min-height: 68px;
  margin-top: 10px;
  padding: 8px 10px 8px 8px;
  box-sizing: border-box;
  border-radius: 18px;
  background: #fffbeb;
  display: flex;
  align-items: center;
}

.common-item:first-child {
  margin-top: 0;
}

.food-thumb {
  width: 52px;
  height: 52px;
  margin-right: 12px;
  border-radius: 14px;
  background: #fef3c7;
  color: #d97706;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
}

.food-thumb-image {
  width: 100%;
  height: 100%;
  border-radius: 14px;
}

.food-info {
  min-width: 0;
  flex: 1;
}

.food-name,
.food-description {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-name {
  color: #451a03;
  font-size: 15px;
  line-height: 1.4;
  font-weight: 950;
}

.food-description {
  margin-top: 3px;
  color: #a16207;
  font-size: 11px;
  line-height: 1.4;
}

.player-card {
  margin-top: 10px;
  padding: 14px;
  border-radius: 18px;
  background: #f8fafc;
}

.player-card:first-child {
  margin-top: 0;
}

.player-name {
  display: block;
  color: #0f172a;
  font-size: 14px;
  line-height: 1.4;
  font-weight: 950;
}

.choice-chip-list {
  margin-top: 9px;
  display: flex;
  flex-wrap: wrap;
}

.choice-chip {
  margin: 0 6px 6px 0;
  padding: 6px 10px;
  border-radius: 999px;
  background: #ffffff;
  color: #475569;
  font-size: 11px;
  line-height: 1.3;
  font-weight: 800;
}

.empty-message,
.empty-player-message {
  display: block;
  color: #94a3b8;
  font-size: 12px;
  line-height: 1.5;
}

.empty-message {
  margin-top: 14px;
  text-align: center;
}

.empty-player-message {
  margin-top: 7px;
}

.return-button {
  width: 100% !important;
  min-width: 0 !important;
  height: 52px !important;
  margin: 18px 0 0 !important;
  padding: 0 16px !important;
  border: 0;
  border-radius: 18px;
  background: #ffd100;
  color: #0f172a;
  box-shadow: 0 10px 20px rgba(245, 158, 11, 0.2);
  font-size: 16px;
  line-height: 52px;
  font-weight: 950;
}

.return-button::after,
.state-button::after {
  border: 0;
}

.state-panel {
  width: 100%;
  max-width: 430px;
  min-height: calc(100vh - 48px);
  margin: 0 auto;
  box-sizing: border-box;
  padding: 48px 24px;
  border-radius: 28px;
  background: #ffffff;
  box-shadow: 0 20px 44px rgba(15, 23, 42, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-emoji {
  display: block;
  margin-bottom: 20px;
  font-size: 52px;
  line-height: 1;
}

.state-title {
  display: block;
  color: #0f172a;
  font-size: 23px;
  line-height: 1.3;
  font-weight: 950;
}

.state-message {
  display: block;
  max-width: 290px;
  margin-top: 10px;
  color: #64748b;
  font-size: 14px;
  line-height: 1.6;
}

.state-button {
  width: 100% !important;
  min-width: 0 !important;
  height: 48px !important;
  margin: 22px 0 0 !important;
  padding: 0 16px !important;
  border: 0;
  border-radius: 16px;
  font-size: 15px;
  line-height: 48px;
  font-weight: 900;
}

.state-button--primary {
  background: #0f172a;
  color: #ffffff;
}

.state-button--secondary {
  margin-top: 10px !important;
  background: #f1f5f9;
  color: #475569;
}

.pressable {
  transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1), background-color 140ms ease, opacity 140ms ease;
}

.entry-fade-up {
  animation: entry-fade-up 220ms cubic-bezier(0.23, 1, 0.32, 1) both;
}

.entry-delay-40 {
  animation-delay: 40ms;
}

.entry-delay-80 {
  animation-delay: 80ms;
}

.entry-delay-120 {
  animation-delay: 120ms;
}

@keyframes entry-fade-up {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
