.settings-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20px 16px 28px;
  color: #0f172a;
}

.settings-shell {
  width: 100%;
  max-width: 430px;
  min-height: calc(100vh - 48px);
  margin: 0 auto;
  animation: page-enter 240ms cubic-bezier(0.23, 1, 0.32, 1) both;
}

.build-info {
  display: block;
  margin: 14px 16px 0;
  color: #94a3b8;
  font-size: 10px;
  line-height: 1.4;
  text-align: center;
}

.summary-card {
  margin-top: 22px;
  padding: 22px 20px;
  border-radius: 26px;
  background: #0f172a;
  color: #ffffff;
  box-shadow: 0 18px 36px rgba(15, 23, 42, 0.18);
}

.summary-kicker {
  display: block;
  color: #cbd5e1;
  font-size: 13px;
  line-height: 1.3;
  font-weight: 800;
}

.summary-count {
  display: block;
  margin-top: 7px;
  color: #fef3c7;
  font-size: 30px;
  line-height: 1.2;
  font-weight: 950;
}

.summary-message {
  display: block;
  margin-top: 8px;
  color: #94a3b8;
  font-size: 12px;
  line-height: 1.5;
}

.amap-config-card {
  margin-top: 14px;
  padding: 18px 16px 16px;
  border-radius: 24px;
  background: #ffffff;
  box-shadow: 0 9px 22px rgba(15, 23, 42, 0.08);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  color: #0f172a;
  font-size: 16px;
  line-height: 1.3;
  font-weight: 950;
}

.section-status {
  padding: 5px 8px;
  border-radius: 999px;
  background: #f1f5f9;
  color: #94a3b8;
  font-size: 10px;
  line-height: 1.2;
  font-weight: 900;
}

.section-status--ready {
  background: #dcfce7;
  color: #15803d;
}

.section-hint,
.config-hint {
  display: block;
  color: #64748b;
  font-size: 11px;
  line-height: 1.5;
}

.section-hint {
  margin-top: 8px;
}

.config-input {
  width: 100%;
  height: 42px;
  margin-top: 10px;
  padding: 0 12px;
  box-sizing: border-box;
  border: 1px solid #e2e8f0;
  border-radius: 13px;
  background: #f8fafc;
  color: #0f172a;
  font-size: 13px;
  line-height: 42px;
}

.config-hint {
  margin-top: 8px;
  color: #94a3b8;
  font-size: 10px;
}

.config-save-button {
  width: 100% !important;
  min-width: 0 !important;
  height: 42px !important;
  margin: 12px 0 0 !important;
  padding: 0 12px !important;
  border: 0;
  border-radius: 14px;
  background: #e0f2fe;
  color: #0369a1;
  font-size: 13px;
  line-height: 42px;
  font-weight: 950;
}

.config-save-button::after {
  border: 0;
}

.filter-tabs {
  display: flex;
  gap: 8px;
  margin-top: 14px;
  padding: 6px;
  border-radius: 18px;
  background: #ffffff;
  box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);
}

.filter-button {
  flex: 1;
  min-width: 0 !important;
  height: 38px !important;
  margin: 0 !important;
  padding: 0 8px !important;
  border: 0;
  border-radius: 12px;
  background: #f8fafc;
  color: #64748b;
  font-size: 13px;
  line-height: 38px;
  font-weight: 900;
}

.filter-button::after,
.food-option::after,
.save-button::after,
.state-button::after,
.confirm-button::after {
  border: 0;
}

.filter-button--selected {
  background: #ffd100;
  color: #0f172a;
  box-shadow: 0 5px 10px rgba(245, 158, 11, 0.18);
}

.food-list {
  height: calc(100vh - 300px);
  min-height: 280px;
  margin-top: 14px;
  padding-bottom: 2px;
  box-sizing: border-box;
}

.food-option {
  width: 100% !important;
  min-width: 0 !important;
  min-height: 78px !important;
  margin: 0 0 10px !important;
  padding: 12px !important;
  box-sizing: border-box;
  border: 1px solid transparent;
  border-radius: 20px;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #0f172a;
  text-align: left;
  box-shadow: 0 8px 18px rgba(15, 23, 42, 0.07);
}

.food-option--selected {
  border-color: #fcd34d;
  background: #fffbeb;
}

.food-option--pressed {
  transform: scale(0.985);
  background: #fef3c7;
}

.food-image {
  width: 54px;
  height: 54px;
  flex: 0 0 54px;
  border-radius: 16px;
  background: #f1f5f9;
}

.food-image--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25px;
}

.check-mark {
  width: 22px;
  height: 22px;
  flex: 0 0 22px;
  box-sizing: border-box;
  border: 2px solid #cbd5e1;
  border-radius: 50%;
  color: #0f172a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  line-height: 1;
  font-weight: 950;
}

.check-mark--selected {
  border-color: #fbbf24;
  background: #ffd100;
}

.food-copy {
  min-width: 0;
  flex: 1;
}

.food-name {
  display: block;
  overflow: hidden;
  color: #0f172a;
  font-size: 15px;
  line-height: 1.35;
  font-weight: 950;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-description {
  display: block;
  margin-top: 4px;
  overflow: hidden;
  color: #94a3b8;
  font-size: 11px;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dataset-badge {
  padding: 5px 7px;
  border-radius: 999px;
  background: #f1f5f9;
  color: #64748b;
  font-size: 10px;
  line-height: 1.2;
  font-weight: 900;
  white-space: nowrap;
}

.save-button {
  width: 100% !important;
  min-width: 0 !important;
  height: 52px !important;
  margin: 14px 0 0 !important;
  padding: 0 16px !important;
  border: 0;
  border-radius: 18px;
  background: #ffd100;
  color: #0f172a;
  box-shadow: 0 10px 20px rgba(245, 158, 11, 0.2);
  font-size: 16px;
  line-height: 52px;
  font-weight: 950;
}

.save-button--disabled {
  background: #e2e8f0;
  color: #94a3b8;
  box-shadow: none;
}

.state-panel {
  min-height: 280px;
  margin-top: 14px;
  padding: 34px 24px;
  box-sizing: border-box;
  border-radius: 24px;
  background: #ffffff;
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.07);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-emoji,
.empty-list-icon {
  display: block;
  font-size: 42px;
  line-height: 1;
}

.state-title {
  display: block;
  margin-top: 16px;
  color: #0f172a;
  font-size: 19px;
  line-height: 1.3;
  font-weight: 950;
}

.state-message,
.empty-list-message {
  display: block;
  margin-top: 8px;
  color: #64748b;
  font-size: 13px;
  line-height: 1.5;
}

.state-button {
  width: 100% !important;
  min-width: 0 !important;
  height: 46px !important;
  margin: 18px 0 0 !important;
  padding: 0 16px !important;
  border: 0;
  border-radius: 16px;
  background: #ffd100;
  color: #0f172a;
  font-size: 14px;
  line-height: 46px;
  font-weight: 950;
}

.empty-list {
  padding: 48px 20px;
  border-radius: 24px;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.07);
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(15, 23, 42, 0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.confirm-dialog {
  width: 100%;
  max-width: 340px;
  padding: 24px 20px 18px;
  box-sizing: border-box;
  border-radius: 24px;
  background: #ffffff;
  box-shadow: 0 24px 54px rgba(15, 23, 42, 0.2);
  text-align: center;
  animation: dialog-pop 180ms cubic-bezier(0.23, 1, 0.32, 1) both;
}

.confirm-title {
  display: block;
  color: #0f172a;
  font-size: 18px;
  line-height: 1.35;
  font-weight: 950;
}

.confirm-message {
  display: block;
  margin-top: 8px;
  color: #64748b;
  font-size: 13px;
  line-height: 1.5;
}

.confirm-actions {
  display: flex;
  gap: 10px;
  margin-top: 20px;
}

.confirm-button {
  flex: 1;
  min-width: 0 !important;
  height: 44px !important;
  margin: 0 !important;
  padding: 0 8px !important;
  border: 0;
  border-radius: 14px;
  font-size: 13px;
  line-height: 44px;
  font-weight: 900;
}

.confirm-button--cancel {
  background: #f1f5f9;
  color: #475569;
}

.confirm-button--danger {
  background: #0f172a;
  color: #ffffff;
}

.toast {
  position: fixed;
  top: 38%;
  left: 50%;
  max-width: calc(100vw - 48px);
  padding: 12px 18px;
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.9);
  color: #ffffff;
  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.2);
  font-size: 14px;
  line-height: 1.35;
  font-weight: 700;
  text-align: center;
  transform: translate(-50%, -50%);
  z-index: 40;
}

.pressable {
  transition-property: transform, background-color, border-color, box-shadow;
  transition-duration: 140ms;
  transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
}

.entry-fade-up {
  animation: entry-fade-up 220ms cubic-bezier(0.23, 1, 0.32, 1) both;
}

.entry-delay-40 {
  animation-delay: 40ms;
}

@keyframes page-enter {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes entry-fade-up {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes dialog-pop {
  from { opacity: 0; transform: scale(0.96) translateY(6px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}
