{
  "name": "@lets-eat/miniprogram",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @lets-eat/client-core build && rm -rf dist && tsc -p tsconfig.json && node scripts/copy-static.mjs && node scripts/write-build-info.mjs",
    "build:mini": "pnpm --filter @lets-eat/miniprogram build",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lets-eat/client-core": "workspace:*",
    "@lets-eat/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "miniprogram-api-typings": "^4.0.5",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
